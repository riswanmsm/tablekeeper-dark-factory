# ==============================================================================
# Dark Factory Configuration (.env)
# ==============================================================================

# BAND Platform Connection
BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket
BAND_REST_URL=https://app.band.ai

# BAND Agent Seat Credentials (create in BAND Desktop room settings)
PLANNER_AGENT_ID=your_planner_agent_id_here
PLANNER_API_KEY=your_planner_api_key_here

BUILDER_AGENT_ID=your_builder_agent_id_here
BUILDER_API_KEY=your_builder_api_key_here

VERIFIER_AGENT_ID=your_verifier_agent_id_here
VERIFIER_API_KEY=your_verifier_api_key_here

# Model Provider (Options: Claude, Featherless, OpenAI, Gemini)
MODEL_NAME=claude-sonnet-4-5
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Alternatively, Featherless AI ($25 free credit code from hackathon):
# OPENAI_BASE_URL=https://api.featherless.ai/v1
# OPENAI_API_KEY=your_featherless_api_key_here
# MODEL_NAME=deepseek-ai/DeepSeek-V3
